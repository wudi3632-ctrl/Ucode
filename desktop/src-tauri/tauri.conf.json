{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UCode Portable",
  "version": "0.2.0",
  "identifier": "dev.ucode.portable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UCode Portable",
        "width": 1440,
        "height": 920,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
